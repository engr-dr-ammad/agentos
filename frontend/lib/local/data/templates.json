   "type": "object",
   "properties": {
    "line_items": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "description": {
        "type": "string"
       },
       "quantity": {
        "type": "number",
        "minimum": 1
       },
       "unit_price": {
        "type": "number",
        "minimum": 0
       }
      },
      "required": [
       "description",
       "quantity",
       "unit_price"
      ]
     }
    },
    "unpriced_items": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "cover_note": {
     "type": "string"
    },
    "citations": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    }
   },
   "required": [
    "line_items",
    "cover_note"
   ]
  },
  "test_cases": [
   {
    "input": {
     "requested_items": [
      "20 office chairs"
     ]
    },
    "expect": {
     "has": "line_items"
    }
   }
  ],
  "status": "published",
  "keywords": [
   "quot",
   "estimate",
   "pricing",
   "proposal",
   "sales",
   "offer"
  ]
