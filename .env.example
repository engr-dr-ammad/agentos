# Copy to .env and replace every value marked CHANGE ME.
AGENTOS_ENV=production
POSTGRES_PASSWORD=CHANGE-ME-db-owner-password
AGENTOS_APP_DB_PASSWORD=CHANGE-ME-app-role-password
# 32+ random characters:  python -c "import secrets;print(secrets.token_urlsafe(48))"
AGENTOS_SECRET_KEY=CHANGE-ME
# Fernet key:  python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AGENTOS_ENCRYPTION_KEY=CHANGE-ME
AGENTOS_PUBLIC_URL=https://agentos.example.com
AGENTOS_COOKIE_SECURE=true
# Block model/API base URLs that resolve to private networks (set true only for self-hosted models on your LAN)
AGENTOS_ALLOW_PRIVATE_HOSTS=false
# Optional Stripe billing (sandbox mode when unset)
# AGENTOS_STRIPE_SECRET_KEY=
# AGENTOS_STRIPE_WEBHOOK_SECRET=
# AGENTOS_STRIPE_PRICE_BUSINESS=
# AGENTOS_STRIPE_PRICE_PROFESSIONAL=
